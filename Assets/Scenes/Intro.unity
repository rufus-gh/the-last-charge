  leapRoll: 16
  leapZoom: 12
  landShake: 0.7
  captions:
  - time: 1.0
    duration: 3.4
    text: "Day thirty-one. The city had lost its power. Then it lost its people."
  - time: 4.8
    duration: 3.4
    text: "Every road was overrun. Nothing down there was still alive."
  - time: 8.6
    duration: 3.4
    text: "But one signal still came from Spectre Tower, on a loop."
  - time: 12.4
    duration: 3.4
    text: "The cure is real, it said. Seven floors down."
  landingCaption: FIND THE HATCH.
